{
  "name": "two-birds-one-rope",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tbob/server & npm run dev --workspace=@tbob/client",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "bot": "npm run bot --workspace=@tbob/server --",
    "smoke": "tsx packages/server/src/smoke.ts",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
